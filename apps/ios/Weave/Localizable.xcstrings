            "value": "Pedir venir"
          }
        }
      }
    },
    "Demandes restantes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests left"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peticiones restantes"
          }
        }
      }
    },
    "Demandes reçues par plan publié, de la plus sollicitée à la moins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests received per plan posted, most asked-about first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peticiones recibidas por plan publicado, del más solicitado al menos."
          }
        }
      }
    },
    "Des plans, pas des profils.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans, not profiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planes, no perfiles."
          }
        }
      }
    },
    "Dites pourquoi ce plan-là.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say why that plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di por qué ese plan."
          }
        }
      }
    },
    "Donner mon accord": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give my consent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar mi consentimiento"
          }
        }
      }
    },
    "Donner ou retirer votre accord pour les données sensibles — les personnes que vous cherchez.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give or withdraw your consent for sensitive data — the people you're looking for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar o retirar tu consentimiento para los datos sensibles — las personas que buscas."
          }
        }
      }
    },
    "Délai de publication": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far ahead"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antelación de publicación"
          }
        }
      }
    },
    "Elle sert à composer votre fil et à situer vos plans. Weave n'enregistre jamais de position plus précise que le kilomètre — pas même la vôtre.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It builds your feed and places your plans. Weave never stores a position finer than the kilometre — not even yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirve para componer tu muro y situar tus planes. Weave nunca guarda una posición más precisa que el kilómetro — ni siquiera la tuya."
          }
        }
      }
    },
    "En continuant, vous acceptez les conditions d'utilisation. Weave est réservé aux personnes majeures.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing you accept the terms of use. Weave is for adults only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar aceptas las condiciones de uso. Weave es solo para mayores de edad."
          }
        }
      }
    },
    "En cours": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En curso"
          }
        }
      }
    },
    "En une phrase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one sentence"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una frase"
          }
        }
      }
    },
    "Enregistrer le fichier": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the file"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar el archivo"
          }
        }
      }
    },
    "Envoyer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar"
          }
        }
      }
    },
    "Envoyer la demande": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the request"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar la petición"
          }
        }
      }
    },
    "Escale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Escale"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escale"
          }
        }
      }
    },
    "Facultative. Elle n'est jamais servie par une adresse devinable : chaque affichage passe par un lien signé qui expire.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. It is never served from a guessable address: every view goes through a signed link that expires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Nunca se sirve desde una dirección adivinable: cada visualización pasa por un enlace firmado que caduca."
          }
        }
      }
    },
    "Fermer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        }
      }
    },
    "Ils filtrent ce que vous voyez ; ils ne changent jamais l'ordre. Le fil est trié par ce qui arrive le plus tôt, puis par ce qui est le plus près.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They filter what you see; they never change the order. The feed is sorted by what happens soonest, then by what is nearest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtran lo que ves; nunca cambian el orden. El muro se ordena por lo que ocurre antes, y luego por lo que está más cerca."
          }
        }
      }
    },
    "Je grimpe depuis six mois, très mal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've been climbing for six months, very badly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevo seis meses escalando, fatal."
          }
        }
      }
    },
    "Je viens de m'installer dans le quartier et je ne connais personne qui grimpe…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've just moved into the area and I don't know anyone who climbs…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabo de mudarme al barrio y no conozco a nadie que escale…"
          }
        }
      }
    },
    "Jours": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días"
          }
        }
      }
    },
    "La bannière affiche votre prochain plan et ce qui attend une réponse. Une notification vous prévient qu'un message est arrivé. Ni l'une ni l'autre ne dit qui écrit, ni ce qui est écrit — elles s'affichent sur un écran verrouillé.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The banner shows your next plan and whatever is waiting for an answer. A notification tells you a message has arrived. Neither says who is writing, nor what — they appear on a lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aviso muestra tu próximo plan y lo que espera respuesta. Una notificación te avisa de que ha llegado un mensaje. Ninguna de las dos dice quién escribe ni qué — se muestran en una pantalla bloqueada."
          }
        }
      }
    },
    "Le badge dit qu'une personne de l'équipe a vérifié que vous êtes bien vous. La suite se fait par e-mail : aucune pièce d'identité ne s'envoie depuis l'application.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The badge says someone on the team has checked that you are you. The rest happens by email: no identity document is ever sent from the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La insignia dice que alguien del equipo ha comprobado que eres tú. El resto se hace por correo: ningún documento de identidad se envía desde la aplicación."
          }
        }
      }
    },
    "Le catalogue n'a pas pu être chargé. Vérifiez votre connexion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The catalogue couldn't be loaded. Check your connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cargar el catálogo. Comprueba tu conexión."
          }
        }
      }
    },
    "Le critère est effacé et le fil cesse de filtrer dessus. Votre compte, vos plans et vos conversations ne changent pas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filter is erased and the feed stops filtering on it. Your account, your plans and your conversations are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El criterio se borra y el muro deja de filtrar por él. Tu cuenta, tus planes y tus conversaciones no cambian."
          }
        }
      }
    },
    "Le prix d'entrée, le niveau, l'heure de fin : ce qui évite un malentendu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price on the door, the level, the finish time: whatever avoids a misunderstanding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio de entrada, el nivel, la hora de fin: lo que evita un malentendido."
          }
        }
      }
    },
    "Le texte fait foi. Cet écran ne fait que vous permettre de donner et de retirer votre accord.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is what binds. This screen only lets you give and withdraw your consent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto es el que obliga. Esta pantalla solo te permite dar y retirar tu consentimiento."
          }
        }
      }
    },
