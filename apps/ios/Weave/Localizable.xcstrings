    "Affiché sur vos plans, et utilisé par les critères des autres.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown on your plans, and used by other people's filters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra en tus planes, y lo usan los criterios de los demás."
          }
        }
      }
    },
