            "state": "translated",
            "value": "Un detalle, si hace falta"
          }
        }
      }
    },
    "Ville": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Town"
