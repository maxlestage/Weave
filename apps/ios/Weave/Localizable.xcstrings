    "Achetés une fois, utilisés quand vous voulez. Ils ne se périment pas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bought once, used whenever you like. They don't expire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprados una vez, usados cuando quieras. No caducan."
          }
        }
      }
    },
