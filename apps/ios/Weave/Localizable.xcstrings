    },
    "Voir les offres": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the plans"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver las suscripciones"
          }
        }
      }
    },
    "Vos données": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos"
          }
        }
      }
    },
    "Vos plans, vos demandes et vos conversations seront effacés. Cette action ne s'annule pas.\n\nUn abonnement souscrit via l'App Store se résilie séparément, dans les réglages de votre compte Apple.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plans, your requests and your conversations will be erased. This cannot be undone.\n\nA subscription taken out through the App Store is cancelled separately, in your Apple account settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus planes, tus peticiones y tus conversaciones se borrarán. Esto no se puede deshacer.\n\nUna suscripción contratada a través de la App Store se cancela aparte, en los ajustes de tu cuenta de Apple."
          }
        }
      }
    },
    "Votre adresse e-mail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email address"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dirección de correo"
          }
        }
      }
    },
    "Votre bilan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Bilan"
          }
        },
