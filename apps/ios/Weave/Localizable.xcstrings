          }
        }
      }
    },
    "Ils filtrent ce que vous voyez ; ils ne changent jamais l'ordre. Le fil est trié par ce qui arrive le plus tôt, puis par ce qui est le plus près.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They filter what you see; they never change the order. The feed is sorted by what happens soonest, then by what is nearest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtran lo que ves; nunca cambian el orden. El muro se ordena por lo que ocurre antes, y luego por lo que está más cerca."
          }
        }
      }
    },
    "Introuvable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not found."
