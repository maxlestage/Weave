    },
    "D'accord": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De acuerdo"
          }
        }
      }
    },
    "Demande envoyée": {
      "extractionState": "manual",
      "localizations": {
