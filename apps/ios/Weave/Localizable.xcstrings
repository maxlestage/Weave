    "%lld / %lld caractères. Facultatif. Une phrase, pas une biographie : ce sont les plans qui parlent pour vous.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld characters. Optional. One sentence, not a biography: your plans speak for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld caracteres. Opcional. Una frase, no una biografía: son los planes los que hablan por ti."
          }
        }
      }
    },
    "%lld / %lld caractères. N'écrivez que ce qui aide à comprendre : ces précisions sont lues par une personne.": {
      "extractionState": "manual",
      "localizations": {
