        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontrado."
          }
        }
      }
    },
    "Je grimpe depuis six mois, très mal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've been climbing for six months, very badly."
