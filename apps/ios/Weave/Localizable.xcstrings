            "value": "Petición enviada"
          }
        }
      }
    },
    "Demander la vérification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask to be verified"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitar la verificación"
          }
        }
      }
    },
    "Demander à venir": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask to come"
          }
        },
        "es": {
          "stringUnit": {
