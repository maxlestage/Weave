<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Trousseau partagé SUR CET APPAREIL : l'application et son extension
       Live Activity lisent la même session. Il ne traverse PAS jusqu'à la
       montre, qui a son propre trousseau : elle reçoit une session à elle,
       par WatchConnectivity. -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.weave.maxlestage.shared</string>
  </array>
  <!-- Notifications distantes : Live Activity démarrée à distance, et alertes
       quand un message arrive alors qu'aucune bannière n'est en cours. -->
  <key>aps-environment</key>
  <string>development</string>
  <!-- Pas de groupe d'application : seuls la montre et sa complication en
       partagent un (ils sont sur la même montre). L'iPhone n'y lirait rien, et
       chaque capacité déclarée est une case de plus à cocher chez Apple. -->
</dict>
</plist>
