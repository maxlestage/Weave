<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Trousseau de la MONTRE : la complication partage celui de l'application
       montre, pas celui de l'iPhone. -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.weave.maxlestage.shared</string>
  </array>
  <!-- Groupe d'application : résumé de la montre pour la complication. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.weave.maxlestage</string>
  </array>
</dict>
</plist>
