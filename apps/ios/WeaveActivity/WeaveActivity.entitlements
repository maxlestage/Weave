<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Trousseau partagé SUR L'IPHONE : l'extension Live Activity lit la même
       session que l'application. -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.weave.app.shared</string>
  </array>
  <!-- Groupe d'application : résumé de la montre pour la complication. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.weave.app</string>
  </array>
</dict>
</plist>
