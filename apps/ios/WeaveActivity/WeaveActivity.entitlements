<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Trousseau partagé SUR L'IPHONE : l'extension Live Activity lit la même
       session que l'application. -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.weave.maxlestage.shared</string>
  </array>
  <!-- Pas de groupe d'application : la Live Activity n'en lit aucun. -->
</dict>
</plist>
