<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Trousseau de la montre. Ce n'est pas celui de l'iPhone : un groupe de
       trousseau relie les applications d'un même appareil, pas deux appareils.
       La montre y range la session que l'iPhone lui transmet, et qui est la
       sienne propre. -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.weave.maxlestage.shared</string>
  </array>
  <!-- Pas de groupe d'application : le résumé destiné à la complication
       passe par ce trousseau (ResumeComplication). Un groupe doit être
       enregistré chez Apple, ce que la signature automatique ne sait pas
       faire avec une clé d'API. -->
</dict>
</plist>
