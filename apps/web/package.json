{
  "name": "@weave/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site vitrine Weave — React 19, Bun, Tailwind, mobile first.",
  "scripts": {
    "dev": "bun --port 5173 ./index.html",
    "build": "tsc --noEmit && bun run build.ts",
    "preview": "bun --port 4173 ./dist/index.html",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@weave/contracts": "*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
