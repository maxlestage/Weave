{
  "name": "@weave/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Weave — Elysia sur Node.js, Prisma (PostgreSQL/SQLite), cache Redis.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "build": "echo \"L'API est exécutée depuis ses sources TypeScript par Node.\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "node ../../scripts/prisma.ts generate",
    "db:migrate": "node ../../scripts/prisma.ts migrate dev",
    "db:deploy": "node ../../scripts/prisma.ts migrate deploy",
    "db:studio": "node ../../scripts/prisma.ts studio",
    "db:seed": "node src/seed.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "db:generate:all": "WEAVE_DB=postgres node ../../scripts/prisma.ts generate && WEAVE_DB=sqlite node ../../scripts/prisma.ts generate"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/jwt": "1.4.2",
    "@elysiajs/node": "1.4.5",
    "@elysiajs/openapi": "1.4.16",
    "@elysiajs/server-timing": "1.4.1",
    "@elysiajs/static": "1.4.10",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@weave/contracts": "*",
    "elysia": "1.4.30",
    "ioredis": "6.0.0",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  }
}
