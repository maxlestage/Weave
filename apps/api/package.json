{
  "name": "@weave/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Weave — Elysia sur Bun, Prisma (PostgreSQL/SQLite), cache Redis natif.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist --minify",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun run ../../scripts/prisma.ts generate",
    "db:migrate": "bun run ../../scripts/prisma.ts migrate dev",
    "db:deploy": "bun run ../../scripts/prisma.ts migrate deploy",
    "db:studio": "bun run ../../scripts/prisma.ts studio",
    "db:seed": "bun src/seed.ts",
    "test": "bun test",
    "db:generate:all": "WEAVE_DB=postgres bun run ../../scripts/prisma.ts generate && WEAVE_DB=sqlite bun run ../../scripts/prisma.ts generate"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/jwt": "1.4.2",
    "@elysiajs/openapi": "1.4.16",
    "@elysiajs/server-timing": "1.4.1",
    "@elysiajs/static": "1.4.10",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@weave/contracts": "*",
    "@weave/prisma-bun-sqlite": "*",
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prisma": "7.10.0",
    "typescript": "7.0.2"
  }
}
