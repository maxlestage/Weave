# Weave — API. Copiez en `.env` et adaptez.

# --- Base de données ------------------------------------------------
# postgres (production, préproduction) | sqlite (développement local uniquement)
WEAVE_DB=sqlite
DATABASE_URL=postgresql://weave:weave@localhost:5432/weave?schema=public
DATABASE_URL_SQLITE=file:./prisma/dev.db

# --- Cache ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Serveur --------------------------------------------------------
PORT=3000
NODE_ENV=development
PUBLIC_WEB_ORIGIN=http://localhost:5173

# --- Jetons ---------------------------------------------------------
# Générez une valeur aléatoire longue : openssl rand -base64 48
JWT_SECRET=changez-moi-en-production-48-octets-minimum
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# --- Médias ---------------------------------------------------------
# Base des URL signées servant les photos et enregistrements vocaux.
MEDIA_BASE_URL=http://localhost:3000/media
MEDIA_SIGNING_SECRET=changez-moi-aussi

# --- APNs (Live Activity + notifications) ---------------------------
# Clé .p8 émise par Apple. Ne jamais commiter le fichier.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.weave.app
APNS_KEY_PATH=./secrets/AuthKey.p8
# sandbox | production
APNS_ENVIRONMENT=sandbox

# --- App Store Server API (abonnements et achats à l'unité) ---------
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_KEY_PATH=./secrets/SubscriptionKey.p8
APPSTORE_ENVIRONMENT=sandbox
