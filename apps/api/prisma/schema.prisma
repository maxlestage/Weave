// Weave — schéma Prisma (source de vérité : PostgreSQL).
//
// Le schéma est volontairement PORTABLE : ni `enum`, ni listes scalaires, ni
// types natifs spécifiques à un moteur. Seul le bloc `datasource` diffère entre
// PostgreSQL (production) et SQLite (développement) ; `bun run db:sqlite`
// dérive automatiquement `schema.sqlite.prisma` à partir de ce fichier.
//
// Le produit tient en quatre objets : un compte, un plan, une demande, une
// conversation. Tout le reste est de la mécanique.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "bun"
}

// Prisma 7 : l'URL de connexion ne vit plus dans le schéma. Elle est fournie
// par `prisma.config.ts` (CLI/migrations) et par l'adaptateur de driver côté
// client (voir `src/lib/prisma.ts`).
datasource db {
  provider = "postgresql"
}

/* ------------------------------------------------------------------ */
/* Identité et accès                                                   */
/* ------------------------------------------------------------------ */

/// Compte utilisateur. Aucune donnée sensible en clair hormis l'e-mail.
model Account {
  id          String   @id @default(cuid(2))
  email       String   @unique
  emailHash   String   @unique /// SHA-256 de l'e-mail normalisé, pour chercher sans exposer.
  handle      String   @unique
  displayName String
  birthDate   DateTime
  /// onboarding | active | paused | suspended | deleting
  status      String   @default("onboarding")
  timezone    String   @default("Europe/Paris")
  locale      String   @default("fr-FR")
  verified    Boolean  @default(false)
  lastSeenAt  DateTime?
  /// Date de demande de suppression ; purge après ACCOUNT_PURGE_DAYS.
  deletionRequestedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile        Profile?
  preference     Preference?
  devices        Device[]
  refreshTokens  RefreshToken[]
  subscription   Subscription?
  unitPurchases  UnitPurchase[]
  credits        CreditBalance[]
  plans          Plan[]
  requests       JoinRequest[]
  conversations  Conversation[]        @relation("conversationGuest")
  hostedTalks    Conversation[]        @relation("conversationHost")
  messages       Message[]
  reportsFiled   Report[]              @relation("reportAuthor")
  reportsAgainst Report[]              @relation("reportTarget")
  blocksMade     Block[]               @relation("blockAuthor")
  blocksReceived Block[]               @relation("blockTarget")
  consents       ConsentRecord[]
  liveActivities LiveActivitySession[]
  auditEvents    AuditEvent[]

  @@index([status])
  @@index([deletionRequestedAt])
  @@map("accounts")
}

/// Code à usage unique envoyé par e-mail (pas de mot de passe dans Weave).
model OtpChallenge {
  id         String    @id @default(cuid(2))
  emailHash  String
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([emailHash, expiresAt])
  @@map("otp_challenges")
}

/// Jeton de rafraîchissement, stocké haché et rotatif.
model RefreshToken {
  id        String    @id @default(cuid(2))
  accountId String
  tokenHash String    @unique
  deviceId  String?
  revokedAt DateTime?
  rotatedTo String?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@map("refresh_tokens")
}

/// Profil. Volontairement maigre : c'est le plan qui porte la substance,
/// pas la fiche.
model Profile {
  id         String  @id @default(cuid(2))
  accountId  String  @unique
  city       String
  /// Coordonnées arrondies (~1 km) : Weave n'expose jamais de position précise.
  latRounded Float
  lonRounded Float
  gender     String
  /// Une phrase, pas une biographie.
  bio        String  @default("")
  /// Clé objet de la photo ; jamais servie sans URL signée.
  photoKey   String?
  photoReviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([latRounded, lonRounded])
  @@map("profiles")
}

/// Critères du fil. La finesse exploitée dépend du palier.
model Preference {
  id            String    @id @default(cuid(2))
  accountId     String    @unique
  minAge        Int       @default(18)
  maxAge        Int       @default(32)
  maxDistanceKm Int       @default(25)
  /// Genres recherchés, encodés en JSON (portabilité SQLite/PostgreSQL).
  seekingJson   String    @default("[]")
  /// Catégories de plans retenues ; vide signifie « toutes ».
  categoriesJson String   @default("[]")
  /// Ville d'Escale temporaire, si une escale est active.
  escaleCity    String?
  escaleUntil   DateTime?
  updatedAt     DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

/* ------------------------------------------------------------------ */
/* Plans et demandes                                                   */
/* ------------------------------------------------------------------ */

/// Ce que quelqu'un compte faire, et à quoi d'autres peuvent se joindre.
model Plan {
  id         String   @id @default(cuid(2))
  authorId   String
  title      String
  note       String   @default("")
  /// sortie | sport | culture | repas | musique | jeux | balade | benevolat
  category   String
  /// Date et heure du rendez-vous.
  startsAt   DateTime
  city       String
  latRounded Float
  lonRounded Float
  /// Personnes attendues en plus de l'auteur (1 à 4).
  capacity   Int      @default(1)
  /// ouvert | complet | passe | annule
  state      String   @default("ouvert")
  cancelledAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author        Account       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  requests      JoinRequest[]
  conversations Conversation[]

  @@index([state, startsAt])
  @@index([latRounded, lonRounded])
  @@index([authorId, startsAt])
  @@map("plans")
}

/// Une demande de rejoindre un plan. Elle contient un message : c'est
/// l'écriture qui engage, jamais un geste.
model JoinRequest {
  id        String    @id @default(cuid(2))
  planId    String
  authorId  String
  message   String
  /// envoyee | acceptee | refusee | expiree | retiree
  state     String    @default("envoyee")
  sentAt    DateTime  @default(now())
  decidedAt DateTime?

  plan         Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  author       Account       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  conversation Conversation?

  /// Une seule demande par personne et par plan : pas de relance en boucle.
  @@unique([planId, authorId])
  @@index([authorId, state])
  @@index([planId, state])
  @@map("join_requests")
}

/// Conversation ouverte quand une demande est acceptée. Toujours à deux, même
/// sur un plan de groupe : on parle à quelqu'un, pas à une salle.
model Conversation {
  id            String    @id @default(cuid(2))
  planId        String
  requestId     String    @unique
  hostId        String
  guestId       String
  openedAt      DateTime  @default(now())
  lastMessageAt DateTime?
  closedAt      DateTime?
  closedBy      String?

  plan     Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  request  JoinRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  host     Account     @relation("conversationHost", fields: [hostId], references: [id], onDelete: Cascade)
  guest    Account     @relation("conversationGuest", fields: [guestId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([hostId, lastMessageAt])
  @@index([guestId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid(2))
  conversationId String
  authorId       String
  body           String
  sentAt         DateTime  @default(now())
  readAt         DateTime?
  /// Purge automatique après MESSAGE_RETENTION_DAYS suivant la clôture.
  purgeAfter     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       Account      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@index([purgeAfter])
  @@map("messages")
}

/* ------------------------------------------------------------------ */
/* Appareils, Live Activity, Apple Watch                               */
/* ------------------------------------------------------------------ */

model Device {
  id               String   @id @default(cuid(2))
  accountId        String
  /// ios | watchos | web
  platform         String
  vendorId         String
  model            String?
  osVersion        String?
  appVersion       String?
  apnsToken        String?
  /// Jeton « push-to-start » ActivityKit : démarrage à distance d'une Live Activity.
  pushToStartToken String?
  /// production | sandbox
  apnsEnvironment  String   @default("sandbox")
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  account        Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  liveActivities LiveActivitySession[]

  @@unique([accountId, vendorId])
  @@index([accountId, platform])
  @@map("devices")
}

model LiveActivitySession {
  id            String    @id @default(cuid(2))
  accountId     String
  deviceId      String
  updateToken   String    @unique
  startedAt     DateTime  @default(now())
  lastStateJson String    @default("{}")
  lastPushAt    DateTime?
  endedAt       DateTime?
  staleAt       DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([accountId, endedAt])
  @@index([staleAt])
  @@map("live_activity_sessions")
}

/* ------------------------------------------------------------------ */
/* Facturation                                                         */
/* ------------------------------------------------------------------ */

model Subscription {
  id                    String    @id @default(cuid(2))
  accountId             String    @unique
  /// depart | viree | escapade | expedition | grandtour
  tier                  String    @default("depart")
  /// monthly | yearly | null pour le socle gratuit
  period                String?
  storeKitProductId     String?
  originalTransactionId String?   @unique
  renewsAt              DateTime?
  expiresAt             DateTime?
  inGracePeriod         Boolean   @default(false)
  cancelledAt           DateTime?
  environment           String    @default("sandbox")
  updatedAt             DateTime  @updatedAt
  createdAt             DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tier, expiresAt])
  @@map("subscriptions")
}

model UnitPurchase {
  id            String    @id @default(cuid(2))
  accountId     String
  /// renfort | horizon | tablee | escale | bilan
  sku           String
  transactionId String    @unique
  quantity      Int       @default(1)
  priceCents    Int
  currency      String    @default("EUR")
  environment   String    @default("sandbox")
  consumedAt    DateTime?
  refundedAt    DateTime?
  purchasedAt   DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, sku])
  @@map("unit_purchases")
}

model CreditBalance {
  id        String    @id @default(cuid(2))
  accountId String
  sku       String
  balance   Int       @default(0)
  resetsAt  DateTime?
  updatedAt DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, sku])
  @@map("credit_balances")
}

/* ------------------------------------------------------------------ */
/* Sécurité, modération, conformité                                    */
/* ------------------------------------------------------------------ */

model Report {
  id        String    @id @default(cuid(2))
  authorId  String
  targetId  String
  reason    String
  details   String    @default("")
  /// ouvert | traite | rejete
  state     String    @default("ouvert")
  handledAt DateTime?
  createdAt DateTime  @default(now())

  author Account @relation("reportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target Account @relation("reportTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([state, createdAt])
  @@map("reports")
}

model Block {
  id        String   @id @default(cuid(2))
  authorId  String
  targetId  String
  createdAt DateTime @default(now())

  author Account @relation("blockAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target Account @relation("blockTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([authorId, targetId])
  @@index([targetId])
  @@map("blocks")
}

/// Registre de consentement RGPD.
model ConsentRecord {
  id        String    @id @default(cuid(2))
  accountId String
  /// cgu | confidentialite | donnees_sensibles | analytique
  kind      String
  version   String
  granted   Boolean
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, kind])
  @@map("consent_records")
}

/// Journal d'audit des actions sensibles.
model AuditEvent {
  id        String   @id @default(cuid(2))
  accountId String?
  action    String
  subject   String?
  metaJson  String   @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@map("audit_events")
}
