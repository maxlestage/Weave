#!/usr/bin/env bash
# Buildpack « inline » de Weave — construction.
#
#   bin/compile <RÉPERTOIRE_BUILD> <RÉPERTOIRE_CACHE> <RÉPERTOIRE_ENV>
#
# Construit le site avec Bun, l'API avec Cargo, puis élague tout ce qui ne sert
# plus, pour tenir dans le slug Heroku plafonné à 500 Mo. Depuis le passage à
# Rust, le dyno n'exécute qu'un binaire : ni Bun ni Node n'ont à y rester.

set -euo pipefail

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="${3:-}"

# Chaque ligne de sortie d'un buildpack est préfixée de « -----> » ou de blancs.
titre() { echo "-----> $*"; }
detail() { echo "       $*"; }

cd "$BUILD_DIR"

# ------------------------------------------------------------------
# Version de Bun
#
# Lue depuis `packageManager` : la version de production ne peut pas diverger
# de celle du développement et de l'intégration continue.
# ------------------------------------------------------------------
BUN_VERSION="$(sed -n 's/.*"packageManager"[[:space:]]*:[[:space:]]*"bun@\([0-9.]*\)".*/\1/p' package.json)"
if [ -z "$BUN_VERSION" ]; then
  echo " !     Impossible de lire la version de Bun depuis package.json (champ packageManager)." >&2
  exit 1
fi

BUN_HOME="$BUILD_DIR/.heroku/bun"
BUN_CACHE="$CACHE_DIR/bun-$BUN_VERSION"

titre "Bun $BUN_VERSION"

if [ -x "$BUN_CACHE/bin/bun" ]; then
  detail "récupéré du cache de construction"
  mkdir -p "$(dirname "$BUN_HOME")"
  cp -R "$BUN_CACHE" "$BUN_HOME"
else
  detail "téléchargement depuis les versions officielles"
  archive="$(mktemp -d)/bun.zip"
  curl -fsSL --retry 3 \
    "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip" \
    -o "$archive"

  mkdir -p "$BUN_HOME/bin"
  unzip -q "$archive" -d "$(dirname "$archive")"
  mv "$(dirname "$archive")/bun-linux-x64/bun" "$BUN_HOME/bin/bun"
  chmod +x "$BUN_HOME/bin/bun"

  mkdir -p "$(dirname "$BUN_CACHE")"
  rm -rf "$BUN_CACHE"
  cp -R "$BUN_HOME" "$BUN_CACHE"
fi

export PATH="$BUN_HOME/bin:$PATH"
detail "$(bun --version)"

# ------------------------------------------------------------------
# Variables de configuration
#
# Heroku les dépose en fichiers, un par variable. On les charge pour la durée
# de la construction, et on signale celles qui manquent — plutôt que de laisser
# l'application échouer au démarrage sans explication.
# ------------------------------------------------------------------
if [ -n "$ENV_DIR" ] && [ -d "$ENV_DIR" ]; then
  for fichier in "$ENV_DIR"/*; do
    [ -f "$fichier" ] || continue
    nom="$(basename "$fichier")"
    case "$nom" in
      PATH | HOME | LD_LIBRARY_PATH | GIT_DIR | CPATH | BUILD_DIR) continue ;;
    esac
    export "$nom=$(cat "$fichier")"
  done
fi

manquantes=""
for nom in DATABASE_URL REDIS_URL JWT_SECRET MEDIA_SIGNING_SECRET DATABASE_SSL_INSECURE REDIS_TLS_INSECURE; do
  if [ -z "${!nom:-}" ]; then manquantes="$manquantes $nom"; fi
done

# ------------------------------------------------------------------
# Construction
# ------------------------------------------------------------------
titre "Dépendances"
BUN_INSTALL_CACHE_DIR="$CACHE_DIR/bun-install" \
  bun install --frozen-lockfile 2>&1 | sed 's/^/       /'

titre "Site vitrine"
bun run --filter @weave/web build 2>&1 | sed 's/^/       /'

# ------------------------------------------------------------------
# L'API, en Rust
#
# La chaîne Rust pèse près d'un gigaoctet : elle vit dans le cache de
# construction, jamais dans le slug. Seul le binaire compilé y entre.
# ------------------------------------------------------------------
RUST_HOME="$CACHE_DIR/rust"
export RUSTUP_HOME="$RUST_HOME/rustup"
export CARGO_HOME="$RUST_HOME/cargo"
export PATH="$CARGO_HOME/bin:$PATH"

if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
  titre "Chaîne Rust"
  detail "installation (première construction, comptez quelques minutes)"
  mkdir -p "$RUSTUP_HOME" "$CARGO_HOME"
  curl -fsSL --retry 3 https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path 2>&1 \
    | sed 's/^/       /'
else
  titre "Chaîne Rust"
  detail "récupérée du cache de construction"
fi
detail "$(rustc --version)"

titre "API Weave"
# Le cache de `target` fait la différence entre dix minutes et une, mais il
# grossit sans fin : on ne garde que ce qui sert au prochain build.
CARGO_TARGET_DIR="$CACHE_DIR/cargo-target" \
  cargo build --release --manifest-path apps/api-rs/Cargo.toml 2>&1 \
  | sed 's/^/       /'

mkdir -p "$BUILD_DIR/bin-release"
cp "$CACHE_DIR/cargo-target/release/weave-api" "$BUILD_DIR/bin-release/weave-api"
chmod +x "$BUILD_DIR/bin-release/weave-api"
detail "binaire : $(du -h "$BUILD_DIR/bin-release/weave-api" | cut -f1)"

# ------------------------------------------------------------------
# Élagage
#
# Le slug est plafonné à 500 Mo, et c'est ce plafond qui a fait échouer les
# premières publications. Rien de ce qui a servi à construire n'a à voyager
# avec le slug : les migrations elles-mêmes sont dans le binaire.
# ------------------------------------------------------------------
titre "Élagage"

# Le site est construit : ses dépendances n'ont plus lieu d'être dans le slug.
# L'API est un binaire, elle n'en a jamais eu besoin.
avant="$(du -sm node_modules 2>/dev/null | cut -f1 || echo 0)"
rm -rf node_modules apps/web/node_modules packages/*/node_modules
detail "node_modules : ${avant} Mo → 0 Mo (retirés)"

# ------------------------------------------------------------------
# Node.js déposé par un autre buildpack
#
# Si `heroku/nodejs` est configuré avant celui-ci, il installe un Node.js
# complet dans `.heroku/node` — 208 Mo — et le laisse dans le slug. Weave ne
# s'en sert jamais : le serveur, les migrations et la construction passent tous
# par Bun. C'est donc 208 Mo de plafond dépensés pour un exécutable mort, et
# c'est ce qui a fait passer le slug de 422 à 622 Mo.
#
# On le retire plutôt que de demander à qui déploie de configurer les
# buildpacks dans le bon ordre : une consigne qu'on peut manquer n'est pas une
# garantie, et celle-ci a déjà été manquée.
#
# Condition pour que ce soit sans danger : plus rien ne doit invoquer un
# `#!/usr/bin/env node`. Depuis le passage à Rust, c'est acquis — le `Procfile`
# n'appelle que le binaire, pour la phase de publication comme pour le dyno
# web.
if [ -d "$BUILD_DIR/.heroku/node" ]; then
  titre "Node.js inutilisé"
  poids="$(du -sm "$BUILD_DIR/.heroku/node" | cut -f1)"
  rm -rf "$BUILD_DIR/.heroku/node"
  # Ce script ajoute au PATH un dossier qui n'existe plus.
  rm -f "$BUILD_DIR/.profile.d/nodejs.sh"
  detail "déposé par un autre buildpack, jamais utilisé : ${poids} Mo rendus"
fi

# ------------------------------------------------------------------
# Environnement d'exécution
# ------------------------------------------------------------------
titre "Environnement d'exécution"
mkdir -p "$BUILD_DIR/.profile.d"
cat > "$BUILD_DIR/.profile.d/weave.sh" <<'PROFILE'
# Exécuté au démarrage de chaque dyno, avant la commande du Procfile.
# L'API est un binaire autonome : Bun ne sert plus qu'à construire le site,
# et n'a rien à faire sur le dyno.

# Valeurs par défaut, qui ne remplacent jamais une variable déjà définie.
export NODE_ENV="${NODE_ENV:-production}"
export WEAVE_DB="${WEAVE_DB:-postgres}"
export WEB_DIST_PATH="${WEB_DIST_PATH:-/app/apps/web/dist}"
PROFILE

# ------------------------------------------------------------------
# Ce que le slug doit contenir
#
# Un slug auquel il manque le binaire, ou le site construit, se publie sans
# erreur : c'est au démarrage que le dyno s'arrête, sur un message qui ne dit ni
# quelle étape a manqué ni pourquoi. Le constater ici coûte une construction ;
# le constater en ligne coûte une publication et une lecture de journal.
# ------------------------------------------------------------------
titre "Vérification du slug"
for attendu in \
  "bin-release/weave-api" \
  "apps/web/dist/index.html"; do
  if [ ! -f "$BUILD_DIR/$attendu" ]; then
    echo " !     Absent du slug après construction : $attendu" >&2
    echo " !     Le dyno s'arrêterait au démarrage. La construction est interrompue ici." >&2
    exit 1
  fi
  detail "présent : $attendu"
done

slug="$(du -sm "$BUILD_DIR" | cut -f1)"
detail "slug : ${slug} Mo (plafond Heroku : 500 Mo)"

if [ "$slug" -gt 500 ]; then
  echo " !     Slug de ${slug} Mo : au-delà de la limite de 500 Mo d'Heroku." >&2
  echo " !     La publication serait rejetée. Voir l'élagage dans bin/compile." >&2
  exit 1
elif [ "$slug" -gt 450 ]; then
  echo " !     Slug de ${slug} Mo : la marge sous la limite de 500 Mo est faible." >&2
fi

if [ -n "$manquantes" ]; then
  echo ""
  echo " !     Variables de configuration absentes :$manquantes"
  echo " !     L'application ne démarrera pas sans elles."
  echo " !     Tableau de bord Heroku → Settings → Config Vars."
  echo " !     Sur Heroku, DATABASE_SSL_INSECURE et REDIS_TLS_INSECURE doivent"
  echo " !     valoir « true » : la base et le cache présentent des certificats"
  echo " !     auto-signés sur le réseau interne. Voir docs/DEPLOIEMENT.md."
  echo ""
fi

titre "Weave est prêt"
