#!/usr/bin/env bash
# Buildpack « inline » de Weave — étape de détection.
#
# Utilisé via le buildpack officiel `heroku-community/inline`, qui exécute les
# scripts `bin/detect`, `bin/compile` et `bin/release` de ce dépôt. Aucun code
# tiers n'intervient : le buildpack est ici, versionné avec l'application.
