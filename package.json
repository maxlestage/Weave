{
  "name": "weave",
  "private": true,
  "type": "module",
  "description": "Weave — application de rencontre : des plans, pas des profils.",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @weave/web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "cargo test --manifest-path apps/api-rs/Cargo.toml",
    "lint": "bunx --bun prettier --check .",
    "verifier": "./verifier.sh",
    "format": "bunx --bun prettier --write .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "setup": "bun install"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "arrowParens": "always"
  }
}
