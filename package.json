{
  "name": "weave",
  "private": true,
  "type": "module",
  "description": "Weave — application de rencontre : 12 fils par jour, en cache uniquement.",
  "license": "UNLICENSED",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter @weave/api dev",
    "dev:web": "bun run --filter @weave/web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "bunx --bun prettier --check .",
    "format": "bunx --bun prettier --write .",
    "db:sqlite": "bun run scripts/gen-sqlite-schema.ts",
    "db:generate": "bun run --filter @weave/api db:generate:all",
    "db:migrate": "bun run --filter @weave/api db:migrate",
    "db:seed": "bun run --filter @weave/api db:seed",
    "db:studio": "bun run --filter @weave/api db:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "setup": "bun install && bun run db:sqlite && bun run db:generate && WEAVE_DB=sqlite bun run db:deploy && bun run db:seed",
    "db:deploy": "bun run --filter @weave/api db:deploy"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "arrowParens": "always"
  }
}
